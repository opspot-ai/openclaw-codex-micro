+        nativeSettings,
+        selectedModel: "gpt-5.4-codex",
+      }),
+    ).toEqual({
+      mode: "plan",
+      settings: {
+        ...nativeSettings.settings,
+        developer_instructions: null,
+      },
+    });
+    expect(
+      resolveCodexConversationPlanModeSettings({
+        planMode: false,
+        nativeSettings: { ...nativeSettings, mode: "plan" },
+        selectedModel: "gpt-5.4-codex",
+      }),
+    ).toEqual({
+      mode: "default",
+      settings: {
+        ...nativeSettings.settings,
+        developer_instructions: null,
+      },
+    });
+  });
+
+  it("fails closed when a full snapshot or matching native model is unavailable", () => {
+    expect(() =>
+      resolveCodexConversationPlanModeSettings({
+        planMode: true,
+        nativeSettings: undefined,
+      }),
+    ).toThrow("complete thread settings snapshot");
+    expect(() =>
+      resolveCodexConversationPlanModeSettings({
+        planMode: true,
+        nativeSettings,
+        selectedModel: "different-model",
+      }),
