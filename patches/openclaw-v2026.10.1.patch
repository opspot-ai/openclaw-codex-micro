+import { createParams, setupRunAttemptTestHooks, tempDir } from "./run-attempt-test-harness.js";
+import {
+  registerCodexTestSessionIdentity,
+  testCodexAppServerBindingStore,
+  writeCodexAppServerBinding,
+} from "./session-binding.test-helpers.js";
+
+// These launch-policy cases use only the in-memory binding fixture. They do
+// not need a durable session owner or its SQLite lifecycle cleanup.
+setupRunAttemptTestHooks({ sessionOwner: null });
+
+describe("normal Codex Plan-mode launch policy", () => {
+  it("clamps a supervised full-permission Plan turn to a native read-only sandbox", async () => {
+    const sessionFile = path.join(tempDir, "plan-supervision.jsonl");
+    const workspaceDir = path.join(tempDir, "plan-supervision-workspace");
+    const params = createParams(sessionFile, workspaceDir);
+    const pluginConfig = { supervision: { enabled: true } };
+    const config = { agents: { entries: { main: {} } } } as never;
+    const agentDir = path.join(tempDir, "plan-supervision-agent");
+    params.agentId = "main";
+    params.agentDir = agentDir;
+    params.planMode = true;
+    params.permissionMode = "read-only";
+    params.storedPermissionMode = "full";
+    params.sessionRoot = workspaceDir;
+    params.execOverrides = { mode: "deny" };
+    params.config = config;
+    registerCodexTestSessionIdentity(sessionFile, params.sessionId, params.sessionKey);
+    const execPolicy = resolveOpenClawExecPolicyForCodexAppServer({
+      config,
+      agentId: "main",
+      permissionMode: "full",
+      execOverrides: { mode: "full" },
+    });
+    const supervisedRuntime = resolveCodexSupervisionAppServerRuntimeOptions({
+      pluginConfig,
+      execPolicy,
+      config,
+      agentDir,
+      modelProvider: "openai",
+      model: "gpt-5.4-codex",
+      sessionPermissionMode: "full",
+      openClawSandboxActive: false,
+      requirementsToml: null,
+    });
+    await writeCodexAppServerBinding(sessionFile, {
+      threadId: "plan-supervised-thread",
+      cwd: workspaceDir,
+      connectionScope: "supervision",
+      supervisionSourceThreadId: "plan-supervised-thread",
+      conversationSourceTransferComplete: true,
+      model: "gpt-5.4-codex",
+      modelProvider: "openai",
+      preserveNativeModel: true,
+      appServerRuntimeFingerprint: buildCodexAppServerConnectionFingerprint(
+        supervisedRuntime,
+        agentDir,
+      ),
+    });
+
+    const connection = await prepareCodexAttemptConnection({
+      params,
+      options: { bindingStore: testCodexAppServerBindingStore, pluginConfig },
+    });
+    try {
+      expect(connection.appServer).toMatchObject({
+        sandbox: "read-only",
+        approvalPolicy: "on-request",
+      });
+      expect(params.permissionMode).toBe("read-only");
