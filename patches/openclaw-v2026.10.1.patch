+  });
+
+  it("uses actual start settings and waits for native Plan readback before the first turn", async () => {
+    const { newThreadId, bindingStore } = setupScenario({ rotateNetworkProfile: true });
+
+    await expect(
+      runBoundTurnWithMissingThreadRecovery(createTurnParams(bindingStore) as never),
+    ).resolves.toMatchObject({ reply: { text: "Plan turn completed" } });
+
+    expect(testState.requests.map(({ method }) => method)).toEqual([
+      "thread/start",
+      "thread/settings/update",
+      "turn/start",
+    ]);
+    const expectedSettings = {
+      mode: "plan",
+      settings: {
+        model: "gpt-5.4-codex",
+        reasoning_effort: "high",
+        developer_instructions: null,
+      },
+    };
+    expect(testState.requests[1]?.params).toEqual({
+      threadId: newThreadId,
+      collaborationMode: expectedSettings,
+    });
+    expect(testState.nativeByThread.get(newThreadId)).toEqual(expectedSettings);
+    expect(testState.turnParams?.collaborationMode).toEqual(expectedSettings);
+  });
+
+  it("initializes an OpenClaw-created bound thread from the captured Plan state", async () => {
+    const { newThreadId, bindingStore } = setupScenario();
+    testState.binding = undefined;
+    const sourceIdentity = sessionBindingIdentity({
+      agentId: "main",
+      sessionId: "session-plan-test",
+      sessionKey: "agent:main:session-plan-test",
+    });
+    const stateDir = sessionDirs.make();
+    vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+    await upsertSessionEntry({
+      agentId: sourceIdentity.agentId,
+      sessionKey: sourceIdentity.sessionKey!,
+      storePath: resolveStorePath(undefined, { agentId: sourceIdentity.agentId }),
+      entry: { sessionId: sourceIdentity.sessionId, updatedAt: 1, planMode: true },
+    });
+
+    await expect(
+      runBoundTurnWithMissingThreadRecovery(createTurnParams(bindingStore) as never),
+    ).resolves.toMatchObject({ reply: { text: "Plan turn completed" } });
+
+    expect(testState.requests.map(({ method }) => method)).toEqual([
+      "config/read",
+      "thread/start",
+      "thread/settings/update",
+      "turn/start",
+    ]);
+    expect(
+      testState.requests.find(({ method }) => method === "thread/settings/update")?.params,
+    ).toMatchObject({
+      threadId: newThreadId,
+      collaborationMode: {
+        mode: "plan",
+        settings: {
+          model: "gpt-5.4-codex",
+          reasoning_effort: "high",
+          developer_instructions: null,
