@@ -0,0 +1,21 @@
+import Foundation
+import WebKit
+
+/// A current trusted dashboard may focus its own window, never another app or document.
+@MainActor
+final class DashboardWindowFocusMessageHandler: NSObject, WKScriptMessageHandlerWithReply {
+    static let name = "openclawWindowFocus"
+    weak var owner: DashboardWindowController?
+
+    func userContentController(
+        _: WKUserContentController,
+        didReceive message: WKScriptMessage,
+        replyHandler: @escaping @MainActor (Any?, String?) -> Void)
+    {
+        guard let owner else {
+            replyHandler(nil, "The dashboard window is no longer available.")
+            return
+        }
+        owner.receiveWindowFocusMessage(message, replyHandler: replyHandler)
+    }
+}
diff --git a/extensions/codex/src/app-server/client-runtime-native-settings.test.ts b/extensions/codex/src/app-server/client-runtime-native-settings.test.ts
new file mode 100644
index 00000000000..90ca0905eb6
--- /dev/null
+++ b/extensions/codex/src/app-server/client-runtime-native-settings.test.ts
@@ -0,0 +1,93 @@
+import { expect, it, vi } from "vitest";
+import {
+  ensureCodexAppServerClientRuntime,
+  readCodexNativeThreadSettings,
+  recordCodexNativeThreadSettings,
+} from "./client-runtime.js";
+import { createClientHarness } from "./test-support.js";
+
+it("tracks complete thread settings through notifications and clears them on retirement", async () => {
+  const harness = createClientHarness();
+  const initial = {
+    mode: "default",
+    settings: {
+      model: "native-model",
+      reasoning_effort: "high",
+      developer_instructions: "Keep native instructions.",
+    },
+  } as const;
+  try {
+    ensureCodexAppServerClientRuntime(harness.client, { agentDir: "/tmp/agent" });
+    expect(recordCodexNativeThreadSettings(harness.client, "native-thread", initial)).toBe(true);
+    expect(readCodexNativeThreadSettings(harness.client, "native-thread")).toEqual(initial);
+
+    harness.send({
+      method: "thread/settings/updated",
+      params: {
+        threadId: "native-thread",
+        threadSettings: { collaborationMode: { ...initial, mode: "plan" } },
+      },
+    });
+    await vi.waitFor(() =>
+      expect(readCodexNativeThreadSettings(harness.client, "native-thread")?.mode).toBe("plan"),
+    );
+
+    harness.send({
+      method: "thread/settings/updated",
+      params: {
+        threadId: "native-thread",
+        threadSettings: { collaborationMode: { mode: "default", settings: { model: 3 } } },
+      },
+    });
+    await vi.waitFor(() =>
+      expect(readCodexNativeThreadSettings(harness.client, "native-thread")).toBeUndefined(),
+    );
+
+    expect(recordCodexNativeThreadSettings(harness.client, "native-thread", initial)).toBe(true);
+    harness.send({ method: "thread/archived", params: { threadId: "native-thread" } });
+    await vi.waitFor(() =>
+      expect(readCodexNativeThreadSettings(harness.client, "native-thread")).toBeUndefined(),
+    );
+  } finally {
+    harness.client.close();
+  }
+  expect(readCodexNativeThreadSettings(harness.client, "native-thread")).toBeUndefined();
+});
+
+it("retains settings across a same-build module copy and invalidates them on client close", async () => {
+  const harness = createClientHarness();
+  const initial = {
+    mode: "plan",
+    settings: {
+      model: "native-model",
+      reasoning_effort: "high",
+      developer_instructions: "Keep native instructions.",
+    },
+  } as const;
+  const addNotificationHandler = vi.spyOn(harness.client, "addNotificationHandler");
+  const addCloseHandler = vi.spyOn(harness.client, "addCloseHandler");
+  try {
+    ensureCodexAppServerClientRuntime(harness.client, { agentDir: "/tmp/agent" });
+    expect(recordCodexNativeThreadSettings(harness.client, "native-thread", initial)).toBe(true);
+
+    vi.resetModules();
+    const [runtimeCopy, settingsCopy] = await Promise.all([
+      import("./client-runtime.js"),
+      import("./thread-native-settings.js"),
+    ]);
+    runtimeCopy.ensureCodexAppServerClientRuntime(harness.client, { agentDir: "/tmp/agent" });
+    settingsCopy.openCodexNativeThreadSettings(harness.client);
+
+    expect(settingsCopy.readCodexNativeThreadSettings(harness.client, "native-thread")).toEqual(
+      initial,
+    );
+    expect(addNotificationHandler).toHaveBeenCalledTimes(2);
+    expect(addCloseHandler).toHaveBeenCalledTimes(2);
+  } finally {
+    harness.client.close();
+  }
+  const settingsCopy = await import("./thread-native-settings.js");
+  expect(
+    settingsCopy.readCodexNativeThreadSettings(harness.client, "native-thread"),
+  ).toBeUndefined();
+});
