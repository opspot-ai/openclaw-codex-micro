+import { describe, expect, it } from "vitest";
+import { projectEffectiveExecPolicy } from "./session-permission-exec-mode.js";
+import {
+  buildSessionPlanModePrompt,
+  resolveSessionPlanModeAttemptFields,
+  resolveCoreSessionPlanModeLaunchPermissionMode,
+  resolveCoreSessionPlanModePermissionMode,
+} from "./session-plan-mode.js";
+
+describe("session Plan mode", () => {
+  it.each([
+    { planMode: true, permissionMode: "full" as const, expected: "read-only" as const },
+    { planMode: true, permissionMode: "workspace" as const, expected: "read-only" as const },
+    { planMode: true, permissionMode: undefined, expected: "read-only" as const },
+    { planMode: false, permissionMode: "full" as const, expected: "full" as const },
+    { planMode: undefined, permissionMode: "guarded" as const, expected: "guarded" as const },
+    { planMode: false, permissionMode: undefined, expected: undefined },
+  ])(
+    "derives effective permissions without changing saved settings: $planMode/$permissionMode",
+    (testCase) => {
+      expect(
+        resolveCoreSessionPlanModePermissionMode({
+          planMode: testCase.planMode,
+          permissionMode: testCase.permissionMode,
+        }),
+      ).toBe(testCase.expected);
+    },
+  );
+
+  it("keeps the Plan clamp after a permission refresh requests broader access", () => {
+    const permissionMode = resolveCoreSessionPlanModePermissionMode({
+      planMode: true,
+      permissionMode: "full",
+    });
+    expect(permissionMode).toBe("read-only");
+    expect(
+      projectEffectiveExecPolicy({
+        base: { mode: "full", security: "full", ask: "off" },
+        overrides: { mode: "full", security: "full", ask: "off" },
+        permissionPolicy: { mode: "read-only" },
+      }),
+    ).toMatchObject({ mode: "deny", security: "deny", ask: "off" });
+  });
+
+  it("uses only a captured saved mode for launch and distinguishes an unset mode from a missing snapshot", () => {
+    expect(
+      resolveCoreSessionPlanModeLaunchPermissionMode({
+        planMode: true,
+        storedPermissionMode: "full",
+        effectivePermissionMode: "read-only",
+      }),
+    ).toBe("full");
+    expect(
+      resolveCoreSessionPlanModeLaunchPermissionMode({
+        planMode: true,
+        storedPermissionMode: null,
+        effectivePermissionMode: "read-only",
+      }),
+    ).toBeUndefined();
+    expect(() =>
+      resolveCoreSessionPlanModeLaunchPermissionMode({
+        planMode: true,
+        storedPermissionMode: undefined,
+        effectivePermissionMode: "read-only",
+      }),
+    ).toThrow("captured session permission snapshot");
+  });
+
+  it("carries the captured Plan and unset sentinel through attempt dispatch serialization", () => {
+    const fields = resolveSessionPlanModeAttemptFields({
+      planMode: true,
+      storedPermissionMode: null,
+    });
+    expect(fields).toEqual({ planMode: true, storedPermissionMode: null });
+    expect(structuredClone(fields)).toEqual({
+      planMode: true,
+      storedPermissionMode: null,
+    });
+    expect(
+      structuredClone(
+        resolveSessionPlanModeAttemptFields({
+          planMode: true,
+          storedPermissionMode: undefined,
+        }),
+      ),
+    ).toEqual({ planMode: true });
+  });
+
+  it("adds planning instructions only while Plan mode is active", () => {
+    expect(buildSessionPlanModePrompt(true)).toContain("host enforces read-only permissions");
+    expect(buildSessionPlanModePrompt(false)).toBeUndefined();
+    expect(buildSessionPlanModePrompt(undefined)).toBeUndefined();
+  });
+});
