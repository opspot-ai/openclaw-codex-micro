+    expect(testState.requests.map(({ method }) => method)).toEqual(["thread/start", "turn/start"]);
+    expect(testState.nativeByThread.has(newThreadId)).toBe(false);
+    expect(testState.turnParams?.collaborationMode).toBeUndefined();
