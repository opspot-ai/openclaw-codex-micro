+      ...nativeCollaborationMode,
+      mode: "plan",
+      settings: { ...nativeCollaborationMode.settings, developer_instructions: null },
+    });
+    expect(turn.effort).toBe("high");
+    expect(turn.model).toBeUndefined();
+    expect(turn.input).toEqual([{ type: "text", text: params.prompt, text_elements: [] }]);
+  });
+
+  it("resets native instructions when changing from Plan to Default", () => {
+    const params = createParams("/tmp/session.jsonl", "/repo");
+    params.planMode = false;
+    const turn = buildTurnStartParams(params, {
+      threadId: "native-default-thread",
+      cwd: "/repo",
+      appServer: createAppServerOptions(),
+      preserveNativeTurnSettings: true,
+      nativeCollaborationMode: nativePlanMode,
+    });
+
+    expect(turn.collaborationMode).toEqual({
+      ...nativePlanMode,
+      mode: "default",
+      settings: { ...nativePlanMode.settings, developer_instructions: null },
+    });
+    expect(turn.effort).toBe("high");
+  });
+
+  it("leaves a native mode untouched when OpenClaw has no explicit Plan override", () => {
+    const params = createParams("/tmp/session.jsonl", "/repo");
+    const turn = buildTurnStartParams(params, {
+      threadId: "native-plan-thread",
+      cwd: "/repo",
+      appServer: createAppServerOptions(),
+      preserveNativeTurnSettings: true,
+      nativeCollaborationMode: nativePlanMode,
+    });
+
+    expect(turn.collaborationMode).toBeUndefined();
+    expect(turn.model).toBeUndefined();
+  });
+
+  it("fails closed when an explicit mode change lacks a complete native snapshot", () => {
+    const params = createParams("/tmp/session.jsonl", "/repo");
