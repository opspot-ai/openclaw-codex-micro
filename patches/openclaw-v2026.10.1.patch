+import { afterEach, describe, expect, it } from "vitest";
+import {
+  ensureCodexAppServerClientRuntime,
+  readCodexNativeThreadSettings,
+} from "./client-runtime.js";
+import { threadStartResult } from "./codex-app-server.test-fixtures.js";
+import { createClientHarness } from "./test-support.js";
+import { resumeCodexAppServerThread } from "./thread-resume.js";
+
+const clients: Array<ReturnType<typeof createClientHarness>["client"]> = [];
+
+afterEach(() => {
+  for (const client of clients.splice(0)) {
+    client.close();
+  }
+});
+
+function createRuntimeClient() {
+  const harness = createClientHarness();
+  clients.push(harness.client);
+  ensureCodexAppServerClientRuntime(harness.client, { agentDir: "/tmp/codex-plan-test" });
+  return harness.client;
+}
+
+describe("native settings from common thread resume", () => {
+  it("caches the complete mode and keeps explicit null settings on the physical client", async () => {
+    const client = createRuntimeClient();
+    const nativeSettings = {
+      mode: "plan",
+      settings: {
+        model: "native-model",
+        reasoning_effort: null,
+        developer_instructions: "Preserve imported developer instructions.",
+      },
+    } as const;
+    const response = {
+      ...threadStartResult("native-thread"),
+      collaborationMode: nativeSettings,
+    };
+
+    await resumeCodexAppServerThread({
+      client,
+      abandonClient: async () => client.close(),
+      request: { threadId: "native-thread" },
+      requestResume: async () => response,
+    });
+
+    expect(readCodexNativeThreadSettings(client, "native-thread")).toEqual(nativeSettings);
+  });
+
+  it("clears the cache when native resume omits required settings", async () => {
+    const client = createRuntimeClient();
+    const response = {
+      ...threadStartResult("native-thread"),
+      collaborationMode: {
+        mode: "default",
+        settings: { model: "native-model" },
+      },
+    };
+
+    await resumeCodexAppServerThread({
+      client,
+      abandonClient: async () => client.close(),
+      request: { threadId: "native-thread" },
+      requestResume: async () => response,
+    });
+
+    expect(readCodexNativeThreadSettings(client, "native-thread")).toBeUndefined();
+  });
+});
