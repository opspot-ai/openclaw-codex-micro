+
+describe("native settings readback ordering", () => {
+  it("keeps a settings notification that arrives before the turn/start acknowledgement", async () => {
+    const requested = {
+      mode: "plan",
+      settings: {
+        model: "test-model",
+        reasoning_effort: null,
+        developer_instructions: null,
+      },
+    } as const;
+    const effective = {
+      mode: "plan",
+      settings: {
+        model: "test-model",
+        reasoning_effort: null,
+        developer_instructions: "Native Plan instructions normalized by Codex.",
+      },
+    } as const;
+    native.cached = undefined;
+    native.requested = requested;
+    native.record.mockReset();
+
+    const recordCodexNativeThreadSettings = (
+      _client: unknown,
+      _threadId: string,
+      settings: unknown,
+    ) => {
+      native.record(settings);
+      native.cached = settings;
+      return true;
+    };
+    let observedRequest: Record<string, unknown> | undefined;
