+    addRequestHandler: () => () => undefined,
+    addCloseHandler: () => () => undefined,
+    close: vi.fn(),
+  };
+  return { oldThreadId, newThreadId, previousClientId, bindingStore: createBindingStore() };
+}
+
+function createTurnParams(bindingStore: ReturnType<typeof createBindingStore>) {
+  const sourceIdentity = sessionBindingIdentity({
+    agentId: "main",
+    sessionId: "session-plan-test",
+    sessionKey: "agent:main:session-plan-test",
+  });
+  return {
+    bindingStore,
+    data: {
+      bindingId: "conversation-plan-test",
+      agentId: "main",
+      agentDir: "/synthetic/agent",
+      workspaceDir: "/synthetic/workspace",
+      source: { ...sourceIdentity, threadId: "thread-source" },
+    },
+    prompt: "Read only while planning.",
+    event: {},
+    incognito: false,
+    timeoutMs: 1_000,
+  };
+}
+
+describe("conversation-bound native Plan mode", () => {
