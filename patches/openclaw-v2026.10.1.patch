+test("sessions.patch reads back Plan mode and rejects a stale expected mode", async () => {
+  const { storePath } = await createSessionStoreDir();
+  const sessionKey = "agent:main:plan-mode-cas";
+  await writeSessionStore({
+    entries: {
+      [sessionKey]: sessionStoreEntry("plan-mode-cas", { planMode: false }),
+    },
+  });
+
+  const enabled = await directSessionReq("sessions.patch", {
+    key: sessionKey,
+    expectedPlanMode: false,
+    planMode: true,
+  });
+  expect(enabled.ok).toBe(true);
+  expect(loadSessionEntry({ sessionKey, storePath })?.planMode).toBe(true);
+
+  const listed = await directSessionReq<{ sessions: Array<{ key: string; planMode?: boolean }> }>(
+    "sessions.list",
+    { agentId: "main", limit: 100 },
+  );
+  expect(listed.payload?.sessions.find((row) => row.key === sessionKey)?.planMode).toBe(true);
+
+  const stale = await directSessionReq("sessions.patch", {
+    key: sessionKey,
+    expectedPlanMode: false,
+    planMode: false,
+  });
+  expect(stale).toMatchObject({
+    ok: false,
+    error: { details: { reason: "session-changed" } },
+  });
+  expect(loadSessionEntry({ sessionKey, storePath })?.planMode).toBe(true);
+
+  const missingReplacement = await directSessionReq("sessions.patch", {
+    key: sessionKey,
+    expectedPlanMode: true,
+    label: "unguarded mode update",
+  });
+  expect(missingReplacement).toMatchObject({
+    ok: false,
+    error: { message: "expectedPlanMode requires a planMode replacement." },
+  });
+  expect(loadSessionEntry({ sessionKey, storePath })).not.toHaveProperty("label");
+});
