@@ -0,0 +1,275 @@
+import { describe, expect, it, vi } from "vitest";
+import type { CodexAppServerClient } from "./client.js";
+import {
+  buildCodexNativeTurnStartModeParams,
+  openCodexNativeThreadSettings,
+  readCodexNativeThreadSettings,
+  recordCodexNativeThreadSettings,
+  resolveCodexNativeCollaborationMode,
+  updateCodexFreshThreadSettings,
+  withCodexNativeCollaborationMode,
+} from "./thread-native-settings.js";
+
+const nativePlanMode = {
+  mode: "plan",
+  settings: {
+    model: "native-model",
+    reasoning_effort: "high",
+    developer_instructions: "Keep the imported thread instructions.",
+  },
+} as const;
+
+function createNativeSettingsFixture() {
+  const notificationHandlers = new Set<(value: unknown) => void>();
+  const closeHandlers = new Set<() => void>();
+  const client = {
+    addNotificationHandler: (handler: (value: unknown) => void) => {
+      notificationHandlers.add(handler);
+      return () => notificationHandlers.delete(handler);
+    },
+    addCloseHandler: (handler: () => void) => {
+      closeHandlers.add(handler);
+      return () => closeHandlers.delete(handler);
+    },
+  } as unknown as CodexAppServerClient;
+  return {
+    client,
+    notify(notification: unknown) {
+      for (const handler of notificationHandlers) {
+        handler(notification);
+      }
+    },
+    close() {
+      for (const handler of closeHandlers) {
+        handler();
+      }
+    },
+  };
+}
+
+describe("Codex native thread settings", () => {
+  it("preserves custom settings in the same mode and requests built-in instructions on mode change", () => {
+    const fixture = createNativeSettingsFixture();
+    openCodexNativeThreadSettings(fixture.client);
+    fixture.notify({
+      method: "thread/settings/updated",
+      params: {
+        threadId: "thread-plan",
+        threadSettings: { collaborationMode: nativePlanMode },
+      },
+    });
+    const parsed = readCodexNativeThreadSettings(fixture.client, "thread-plan");
+
+    expect(parsed).toEqual(nativePlanMode);
+    expect(parsed && withCodexNativeCollaborationMode(parsed, "default")).toEqual({
+      mode: "default",
+      settings: {
+        model: "native-model",
+        reasoning_effort: "high",
+        developer_instructions: null,
+      },
+    });
+    expect(parsed && withCodexNativeCollaborationMode(parsed, "plan")).toEqual({
+      ...nativePlanMode,
+      settings: { ...nativePlanMode.settings },
+    });
+  });
+
+  it("waits for the authoritative native update notification after the RPC acknowledgment", async () => {
+    const notifications = new Set<(value: unknown) => void>();
+    const closeHandlers = new Set<() => void>();
+    const requests: Array<{ method: string; params: unknown }> = [];
+    const request = vi.fn(async (method: string, params?: unknown) => {
+      requests.push({ method, params });
+      return {};
+    });
+    const client = {
+      request,
+      addNotificationHandler: (handler: (value: unknown) => void) => {
+        notifications.add(handler);
+        return () => notifications.delete(handler);
+      },
+      addCloseHandler: (handler: () => void) => {
+        closeHandlers.add(handler);
+        return () => closeHandlers.delete(handler);
+      },
+    } as unknown as CodexAppServerClient;
+    const expected = {
+      mode: "plan" as const,
+      settings: {
+        model: "fresh-model",
+        reasoning_effort: "medium",
+        developer_instructions: null,
+      },
+    };
+    let settled = false;
+    const pending = updateCodexFreshThreadSettings({
+      client,
+      threadId: "fresh-thread",
+      mode: "plan",
+      model: expected.settings.model,
+      reasoningEffort: expected.settings.reasoning_effort,
+      requestOptions: { timeoutMs: 1_000 },
+    }).then((value) => {
+      settled = true;
+      return value;
+    });
+
+    await vi.waitFor(() => expect(requests).toHaveLength(1));
+    expect(requests[0]).toEqual({
+      method: "thread/settings/update",
+      params: { threadId: "fresh-thread", collaborationMode: expected },
+    });
+    await Promise.resolve();
+    expect(settled).toBe(false);
+
+    for (const handler of notifications) {
+      handler({
+        method: "thread/settings/updated",
+        params: { threadId: "fresh-thread", threadSettings: { collaborationMode: expected } },
+      });
+    }
+    await expect(pending).resolves.toEqual(expected);
+    expect(closeHandlers.size).toBe(1);
+    expect(notifications.size).toBe(1);
+  });
+
+  it("rejects a fresh native settings update without the complete actual start tuple", async () => {
+    const request = vi.fn();
+    const client = {
+      request,
+      addNotificationHandler: vi.fn(),
+      addCloseHandler: vi.fn(),
+    } as unknown as CodexAppServerClient;
+    await expect(
+      updateCodexFreshThreadSettings({
+        client,
+        threadId: "fresh-thread",
+        mode: "default",
+        model: "fresh-model",
+        reasoningEffort: undefined,
+        requestOptions: { timeoutMs: 100 },
+      }),
+    ).rejects.toThrow("actual thread model and effort");
+    expect(request).not.toHaveBeenCalled();
+  });
+
+  it("requires a complete matching snapshot before changing native collaboration mode", () => {
+    expect(
+      resolveCodexNativeCollaborationMode({
+        planMode: false,
+        nativeSettings: nativePlanMode,
+        selectedModel: "native-model",
+      }),
+    ).toEqual({
+      mode: "default",
+      settings: {
+        ...nativePlanMode.settings,
+        developer_instructions: null,
+      },
+    });
+    expect(
+      resolveCodexNativeCollaborationMode({
+        planMode: undefined,
+        nativeSettings: undefined,
+      }),
+    ).toBeUndefined();
+    expect(() =>
+      resolveCodexNativeCollaborationMode({
+        planMode: true,
+        nativeSettings: undefined,
+      }),
+    ).toThrow("complete thread settings snapshot");
+    expect(() =>
+      resolveCodexNativeCollaborationMode({
+        planMode: true,
+        nativeSettings: nativePlanMode,
+        selectedModel: "other-model",
+      }),
+    ).toThrow("selected model differs");
+  });
+
+  it("sends native Plan settings unchanged and leaves supervision settings to Codex", () => {
+    expect(
+      buildCodexNativeTurnStartModeParams({
+        planCollaborationMode: nativePlanMode,
+        usesSupervisionConnection: false,
+        model: "ignored-model",
+        effort: "low",
+      }),
+    ).toEqual({ collaborationMode: nativePlanMode });
+    expect(
+      buildCodexNativeTurnStartModeParams({
+        planCollaborationMode: undefined,
+        usesSupervisionConnection: true,
+        model: "native-model",
+        effort: "low",
+      }),
+    ).toEqual({});
+    expect(
+      buildCodexNativeTurnStartModeParams({
+        planCollaborationMode: undefined,
+        usesSupervisionConnection: false,
+        model: "native-model",
+        effort: "low",
+      }),
+    ).toEqual({
+      effort: "low",
+      collaborationMode: {
+        mode: "default",
+        settings: {
+          model: "native-model",
+          reasoning_effort: "low",
+          developer_instructions: null,
+        },
+      },
+    });
+  });
+
+  it("preserves explicit null and rejects incomplete native settings", () => {
+    const fixture = createNativeSettingsFixture();
+    openCodexNativeThreadSettings(fixture.client);
+    const complete = {
+      mode: "default",
+      settings: {
+        model: "native-model",
+        reasoning_effort: null,
+        developer_instructions: null,
+      },
+    };
+    expect(recordCodexNativeThreadSettings(fixture.client, "complete", complete)).toBe(true);
+    expect(readCodexNativeThreadSettings(fixture.client, "complete")).toEqual(complete);
+    for (const incomplete of [
+      { mode: "default", settings: { model: "native-model" } },
+      { mode: "default", settings: { model: "native-model", reasoning_effort: null } },
+      { mode: "default", settings: { model: "native-model", developer_instructions: null } },
+      { mode: "default", settings: { model: 1 } },
+    ]) {
+      expect(recordCodexNativeThreadSettings(fixture.client, "incomplete", incomplete)).toBe(false);
+      expect(readCodexNativeThreadSettings(fixture.client, "incomplete")).toBeUndefined();
+    }
+  });
+
+  it("keeps the cache bounded, refreshes reads, and removes stale values on invalid updates", () => {
+    const fixture = createNativeSettingsFixture();
+    openCodexNativeThreadSettings(fixture.client);
+    for (let index = 0; index < 64; index += 1) {
+      expect(
+        recordCodexNativeThreadSettings(fixture.client, `thread-${index}`, nativePlanMode),
+      ).toBe(true);
+    }
+    expect(readCodexNativeThreadSettings(fixture.client, "thread-0")).toEqual(nativePlanMode);
+    expect(recordCodexNativeThreadSettings(fixture.client, "thread-64", nativePlanMode)).toBe(true);
+    expect(readCodexNativeThreadSettings(fixture.client, "thread-0")).toEqual(nativePlanMode);
+    expect(readCodexNativeThreadSettings(fixture.client, "thread-1")).toBeUndefined();
+    expect(
+      recordCodexNativeThreadSettings(fixture.client, "thread-0", {
+        mode: "default",
+        settings: { model: "partial" },
+      }),
+    ).toBe(false);
+    expect(readCodexNativeThreadSettings(fixture.client, "thread-0")).toBeUndefined();
+    fixture.close();
+    expect(readCodexNativeThreadSettings(fixture.client, "thread-64")).toBeUndefined();
+  });
+});
diff --git a/extensions/codex/src/app-server/thread-native-settings.ts b/extensions/codex/src/app-server/thread-native-settings.ts
