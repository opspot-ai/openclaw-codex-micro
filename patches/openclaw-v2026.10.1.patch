+import type { SessionEntry } from "../config/sessions/types.js";
+
+const SESSION_PLAN_MODE_SYSTEM_PROMPT = [
+  "Plan mode is active for this session.",
+  "Use available read-only information to prepare a concrete plan, then return the plan and wait for a separate request before making changes.",
+  "The host enforces read-only permissions for this run; do not treat the session's saved permissions as available authority.",
+].join("\n\n");
+
+export function resolveCoreSessionPlanModePermissionMode(params: {
+  planMode: boolean | undefined;
+  permissionMode: SessionEntry["permissionMode"] | null | undefined;
+}): SessionEntry["permissionMode"] | undefined {
+  if (params.planMode === true) {
+    return "read-only";
+  }
+  return params.permissionMode ?? undefined;
+}
+
+/** Resolve native launch authority without treating Plan's effective clamp as saved authority. */
+export function resolveCoreSessionPlanModeLaunchPermissionMode(params: {
+  planMode: boolean | undefined;
+  storedPermissionMode: SessionEntry["permissionMode"] | null | undefined;
+  effectivePermissionMode: SessionEntry["permissionMode"] | undefined;
+}): SessionEntry["permissionMode"] | undefined {
+  if (params.planMode !== true) {
+    return params.effectivePermissionMode;
+  }
+  if (params.storedPermissionMode === undefined) {
+    throw new Error("Plan mode requires a captured session permission snapshot.");
+  }
+  return params.storedPermissionMode ?? undefined;
+}
+
+/** Preserve the captured source mode across the real harness dispatch boundary. */
+export function resolveSessionPlanModeAttemptFields(params: {
+  planMode?: boolean;
+  storedPermissionMode?: SessionEntry["permissionMode"] | null;
+}) {
+  return {
+    planMode: params.planMode,
+    storedPermissionMode: params.storedPermissionMode,
+  };
+}
+
+export function buildSessionPlanModePrompt(planMode: boolean | undefined): string | undefined {
+  return planMode === true ? SESSION_PLAN_MODE_SYSTEM_PROMPT : undefined;
+}
diff --git a/ui/src/app/native-window-focus.test.ts b/ui/src/app/native-window-focus.test.ts
new file mode 100644
index 00000000000..f1ae013e9eb
--- /dev/null
+++ b/ui/src/app/native-window-focus.test.ts
@@ -0,0 +1,104 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { focusControlUiWindow, openControlUiExternalLink } from "./native-window-focus.ts";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+describe("Control UI window focus", () => {
+  it("reports the browser's actual focus result when no native bridge is present", async () => {
+    const focus = vi.spyOn(window, "focus").mockImplementation(() => {});
+    vi.spyOn(document, "hasFocus").mockReturnValue(false);
+    expect(await focusControlUiWindow(new AbortController().signal)).toBe(false);
+    expect(focus).toHaveBeenCalledOnce();
+  });
+
+  it("uses the native acknowledgement instead of assuming a requested focus succeeded", async () => {
+    const postMessage = vi
+      .fn()
+      .mockResolvedValueOnce({ focused: false })
+      .mockResolvedValueOnce({ focused: true });
+    vi.stubGlobal("webkit", { messageHandlers: { openclawWindowFocus: { postMessage } } });
+    expect(await focusControlUiWindow(new AbortController().signal)).toBe(false);
+    expect(await focusControlUiWindow(new AbortController().signal)).toBe(true);
+    expect(postMessage.mock.calls).toEqual([
+      [{ type: "focus-window" }],
+      [{ type: "focus-window" }],
+    ]);
+  });
+
+  it("does not accept an acknowledgement after its caller has ended", async () => {
+    const pending = Promise.withResolvers<unknown>();
+    vi.stubGlobal("webkit", {
+      messageHandlers: { openclawWindowFocus: { postMessage: () => pending.promise } },
+    });
+    const lifetime = new AbortController();
+    const result = focusControlUiWindow(lifetime.signal);
+    lifetime.abort();
+    pending.resolve({ focused: true });
+    await expect(result).rejects.toThrow();
+  });
+
+  it("rejects a response from a replaced native bridge", async () => {
+    const pending = Promise.withResolvers<unknown>();
+    const handlers = { openclawWindowFocus: { postMessage: () => pending.promise } };
+    vi.stubGlobal("webkit", { messageHandlers: handlers });
+    const result = focusControlUiWindow(new AbortController().signal);
+    handlers.openclawWindowFocus = { postMessage: async () => ({ focused: true }) };
+    pending.resolve({ focused: true });
+    await expect(result).rejects.toThrow("connection changed");
+  });
+});
+
+describe("Control UI external links", () => {
+  it("rejects executable schemes and embedded credentials before opening anything", async () => {
+    const open = vi.spyOn(window, "open").mockReturnValue(null);
+    for (const url of [
+      "javascript:alert(1)",
+      "file:///tmp/test",
+      "https://user:secret@example.test",
+    ]) {
+      await expect(openControlUiExternalLink(url, new AbortController().signal)).rejects.toThrow();
+    }
+    expect(open).not.toHaveBeenCalled();
+  });
+
+  it("reports popup refusal and detaches the opener before navigating an admitted window", async () => {
+    const opened = { opener: window, location: { replace: vi.fn() } };
+    const open = vi
+      .spyOn(window, "open")
+      .mockReturnValueOnce(null)
+      .mockReturnValueOnce(opened as unknown as Window);
+    expect(
+      await openControlUiExternalLink("https://example.test/", new AbortController().signal),
+    ).toBe(false);
+    opened.location.replace.mockImplementation(() => {
+      expect(opened.opener).toBeNull();
+    });
+    expect(
+      await openControlUiExternalLink("https://example.test/", new AbortController().signal),
+    ).toBe(true);
+    expect(opened.location.replace).toHaveBeenCalledWith("https://example.test/");
+    expect(open).toHaveBeenCalledTimes(2);
+  });
+
+  it("uses the current native link owner and rejects a retired caller", async () => {
+    const postMessage = vi.fn();
+    vi.stubGlobal("webkit", { messageHandlers: { openclawLink: { postMessage } } });
+    expect(
+      await openControlUiExternalLink("https://example.test/", new AbortController().signal),
+    ).toBe(true);
+    expect(postMessage).toHaveBeenCalledWith({
+      type: "open-link",
+      url: "https://example.test/",
+      target: "external",
+    });
+    const ended = new AbortController();
+    ended.abort();
+    await expect(
+      openControlUiExternalLink("https://example.test/", ended.signal),
+    ).rejects.toThrow();
+    expect(postMessage).toHaveBeenCalledOnce();
+  });
+});
diff --git a/ui/src/app/native-window-focus.ts b/ui/src/app/native-window-focus.ts
new file mode 100644
index 00000000000..8d10400e8de
--- /dev/null
+++ b/ui/src/app/native-window-focus.ts
@@ -0,0 +1,49 @@
+import { reserveExternalWindowForDeferredNavigation } from "../lib/open-external-url.ts";
+import { postNativeExternalLink } from "./native-link-routing.ts";
+import { webKitHostWindow } from "./native-webkit-bridge.ts";
+
+type WindowFocusHandler = { postMessage: (request: { type: "focus-window" }) => Promise<unknown> };
+
+/** Focus this dashboard only; regular browsers retain their own focus policy. */
+export async function focusControlUiWindow(signal: AbortSignal): Promise<boolean> {
+  signal.throwIfAborted();
+  // SAFETY: The macOS dashboard registers this reply-capable handler on its trusted WKWebView; the reply is validated below.
+  const nativeWindow = window as Window & {
+    webkit?: { messageHandlers?: { openclawWindowFocus?: WindowFocusHandler } };
+  };
+  const handler = nativeWindow.webkit?.messageHandlers?.openclawWindowFocus;
+  if (typeof handler?.postMessage !== "function") {
+    window.focus();
+    return document.hasFocus();
+  }
+  const sendFocusRequest = handler.postMessage.bind(handler);
+  const reply = await sendFocusRequest({ type: "focus-window" });
+  signal.throwIfAborted();
+  if (nativeWindow.webkit?.messageHandlers?.openclawWindowFocus !== handler) {
+    throw new Error("The native window connection changed. Use its current Control UI.");
+  }
+  return (
+    typeof reply === "object" && reply !== null && "focused" in reply && reply.focused === true
+  );
+}
+
+/** Reuse the native link policy and the browser's detached window navigation. */
+export async function openControlUiExternalLink(
+  rawUrl: string,
+  signal: AbortSignal,
+): Promise<boolean> {
+  signal.throwIfAborted();
+  const url = new URL(rawUrl);
+  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password) {
+    throw new Error("External links require an HTTP or HTTPS URL without embedded credentials.");
+  }
+  if (webKitHostWindow()?.webkit?.messageHandlers?.openclawLink) {
+    return postNativeExternalLink(url.href);
+  }
+  const opened = reserveExternalWindowForDeferredNavigation();
+  if (!opened) {
+    return false;
+  }
+  opened.location.replace(url.href);
+  return true;
+}
diff --git a/ui/src/pages/chat/chat-plugin-dictation.test.ts b/ui/src/pages/chat/chat-plugin-dictation.test.ts
new file mode 100644
index 00000000000..0c219fa6753
--- /dev/null
+++ b/ui/src/pages/chat/chat-plugin-dictation.test.ts
@@ -0,0 +1,108 @@
+/* @vitest-environment jsdom */
+
+import { render } from "lit";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createComposerProps } from "./chat-composer.test-support.ts";
+import { getChatComposerState } from "./components/chat-composer-state.ts";
+import { renderChatComposer, resetChatComposerState } from "./components/chat-composer.ts";
+
+type NativeDictationControls = {
+  start: () => boolean;
+  finish: () => Promise<boolean>;
+};
+
+afterEach(() => {
+  resetChatComposerState();
+  document.body.replaceChildren();
+  vi.restoreAllMocks();
+});
+
+describe("native composer dictation hooks", () => {
+  it("starts and finishes native dictation without invoking Talk or Send", async () => {
+    const paneId = "native-dictation";
+    const onToggleRealtimeTalk = vi.fn();
+    const onSend = vi.fn();
+    const container = document.createElement("div");
+    let controls: NativeDictationControls | null = null;
+    render(
+      renderChatComposer(
+        createComposerProps({
+          paneId,
+          sessionKey: "agent:main:session-a",
+          draft: "keep this draft",
+          onSend,
+          onToggleRealtimeTalk,
+        }),
+        (next) => {
+          controls = next;
+        },
+      ),
+      container,
+    );
+
+    const state = getChatComposerState(paneId);
+    const controller = state.dictation;
+    const textarea = container.querySelector<HTMLTextAreaElement>("textarea");
+    expect(controller).not.toBeNull();
+    expect(textarea).not.toBeNull();
+    if (!controller || !textarea || !controls) {
+      throw new Error("native dictation hooks were not captured");
+    }
+    textarea.setSelectionRange(5, 9);
+    const startDirect = vi.spyOn(controller, "startDirect").mockReturnValue(true);
+    const finishActive = vi.spyOn(controller, "finishActive").mockResolvedValue(true);
+
+    expect(controls.start()).toBe(true);
+    expect(startDirect).toHaveBeenCalledOnce();
+    expect(state.dictationSelection).toEqual({ start: 5, end: 9, value: "keep this draft" });
+    expect(textarea.readOnly).toBe(true);
+    await expect(controls.finish()).resolves.toBe(true);
+    expect(finishActive).toHaveBeenCalledOnce();
+    expect(onToggleRealtimeTalk).not.toHaveBeenCalled();
+    expect(onSend).not.toHaveBeenCalled();
+  });
+
+  it("rejects callbacks captured for a composer after its session changes", async () => {
+    const paneId = "native-dictation-owner";
+    const container = document.createElement("div");
+    let oldControls: NativeDictationControls | null = null;
+    const draw = (sessionKey: string, capture: (value: NativeDictationControls | null) => void) =>
+      render(
+        renderChatComposer(
+          createComposerProps({ paneId, sessionKey, onToggleRealtimeTalk: vi.fn() }),
+          capture,
+        ),
+        container,
+      );
+    draw("agent:main:session-a", (next) => {
+      oldControls = next;
+    });
+    const oldController = getChatComposerState(paneId).dictation;
+    expect(oldController).not.toBeNull();
+    if (!oldController || !oldControls) {
+      throw new Error("initial native dictation hooks were not captured");
+    }
+    const oldStart = vi.spyOn(oldController, "startDirect").mockReturnValue(true);
+    const oldFinish = vi.spyOn(oldController, "finishActive").mockResolvedValue(true);
+    let currentControls: NativeDictationControls | null = null;
+    draw("agent:main:session-b", (next) => {
+      currentControls = next;
+    });
+    const currentController = getChatComposerState(paneId).dictation;
+    expect(currentController).not.toBeNull();
+    if (!currentController || !currentControls) {
+      throw new Error("replacement native dictation hooks were not captured");
+    }
+    const currentStart = vi.spyOn(currentController, "startDirect").mockReturnValue(true);
+    const currentFinish = vi.spyOn(currentController, "finishActive").mockResolvedValue(true);
+
+    expect(oldControls.start()).toBe(false);
+    await expect(oldControls.finish()).resolves.toBe(false);
+    expect(oldStart).not.toHaveBeenCalled();
+    expect(oldFinish).not.toHaveBeenCalled();
+    expect(currentStart).not.toHaveBeenCalled();
+    expect(currentFinish).not.toHaveBeenCalled();
+    expect(currentControls.start()).toBe(true);
+    expect(currentStart).toHaveBeenCalledOnce();
+  });
+});
