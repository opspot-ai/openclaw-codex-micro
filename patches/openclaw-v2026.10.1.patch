+import { resolveStorePath, upsertSessionEntry } from "openclaw/plugin-sdk/session-store-runtime";
+import { useSessionStoreTempDirs } from "openclaw/plugin-sdk/sqlite-runtime-testing";
+import { afterAll, afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  assertNativeConversationApprovalPolicySupported,
+  resolveConversationAppServerRuntime,
+  type CodexConversationConfig,
+} from "./conversation-binding-preparation.js";
+
+const sessionDirs = useSessionStoreTempDirs(afterAll, "openclaw-codex-plan-binding-");
+
+describe("bound conversation Plan launch policy", () => {
+  let stateDir: string;
+  let workspaceDir: string;
+
+  beforeEach(() => {
+    stateDir = sessionDirs.make();
+    workspaceDir = `${stateDir}/workspace`;
+    vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+  });
+
+  afterEach(() => vi.unstubAllEnvs());
+
+  async function prepare(options: { permissionMode?: "full" | "read-only"; execMode?: "deny" }) {
+    const agentId = "main";
+    const sessionId = "plan-bound-session";
+    const sessionKey = "agent:main:plan-bound-session";
+    const storePath = resolveStorePath(undefined, { agentId });
+    await upsertSessionEntry({
+      agentId,
+      sessionKey,
+      storePath,
+      entry: {
+        sessionId,
+        updatedAt: 1,
+        planMode: true,
+        ...(options.permissionMode ? { permissionMode: options.permissionMode } : {}),
+        sessionRoot: workspaceDir,
+      },
+    });
+    const config = {
+      agents: { defaults: { workspace: workspaceDir }, entries: { main: {} } },
+      ...(options.execMode ? { tools: { exec: { mode: options.execMode } } } : {}),
+    } as CodexConversationConfig;
+    return await resolveConversationAppServerRuntime({
+      config,
+      source: { agentId, sessionId, sessionKey, threadId: "thread-source" },
+      workspaceDir,
+      agentDir: `${stateDir}/agent`,
+      modelProvider: "openai",
+      model: "gpt-5.5",
+    });
+  }
+
+  it("uses an actual read-only native sandbox for a bound Plan session with saved full access", async () => {
+    const prepared = await prepare({ permissionMode: "full" });
+    expect(prepared.planMode).toBe(true);
+    expect(prepared.runtime).toMatchObject({
+      sandbox: "read-only",
+      approvalPolicy: "never",
+    });
+  });
+
+  it("keeps configured exec denial authoritative when the saved permission is unset", async () => {
+    await expect(prepare({ execMode: "deny" })).rejects.toThrow("effective tools.exec.mode=deny");
+  });
+
+  it("keeps saved read-only authority behind the unsupported approval guard", async () => {
+    const prepared = await prepare({ permissionMode: "read-only" });
+    expect(prepared.runtime).toMatchObject({
+      sandbox: "read-only",
+      approvalPolicy: "on-request",
+    });
+    expect(() => assertNativeConversationApprovalPolicySupported(prepared.runtime)).toThrow(
+      "cannot route interactive approvals yet",
+    );
+  });
+});
