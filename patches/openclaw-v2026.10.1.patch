+    setupScenario();
+  });
+
+  afterEach(() => vi.unstubAllEnvs());
+
+  it("keeps an absent source mode unknown", () => {
+    expect(
+      resolveCodexConversationPlanModeSettings({
+        planMode: undefined,
+        nativeSettings: undefined,
+      }),
+    ).toBeUndefined();
+  });
+
+  it("preserves same-mode settings and resets instructions when changing native modes", () => {
+    expect(
+      resolveCodexConversationPlanModeSettings({
