+    expect(testState.turnParams?.collaborationMode).toEqual({
+      mode: "default",
+      settings: {
+        model: "gpt-5.4-codex",
+        reasoning_effort: "high",
+        developer_instructions: null,
+      },
+    });
+    expect(testState.releasedBindings).toHaveLength(1);
+    expect(testState.releasedBindings[0]).toMatchObject({
+      clientId: previousClientId,
+      threadId: oldThreadId,
+    });
+    expect(testState.siblingClientThreads).toEqual(new Set(["thread-owned-by-sibling"]));
+    expect(testState.closedClients).toEqual([]);
