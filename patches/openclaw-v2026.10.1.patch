+
+  it("keeps explicit saved read-only authority in the native sandbox", async () => {
+    const sessionFile = path.join(tempDir, "plan-saved-readonly.jsonl");
+    const workspaceDir = path.join(tempDir, "plan-saved-readonly-workspace");
+    const params = createParams(sessionFile, workspaceDir);
+    params.agentId = "main";
+    params.planMode = true;
+    params.permissionMode = "read-only";
+    params.storedPermissionMode = "read-only";
