+
+    expect(testState.requests.map(({ method }) => method)).toEqual([
+      "thread/start",
+      "thread/settings/update",
+      "turn/start",
+    ]);
+    expect(testState.requests[1]?.params).toEqual({
+      threadId: newThreadId,
+      collaborationMode: {
+        mode: "default",
+        settings: {
+          model: "gpt-5.4-codex",
+          reasoning_effort: "high",
+          developer_instructions: null,
+        },
+      },
