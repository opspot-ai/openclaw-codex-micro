index 00000000000..cf46000043d
--- /dev/null
+++ b/extensions/codex/src/app-server/thread-native-settings.ts
@@ -0,0 +1,430 @@
+import {
+  resolveSessionPlanModeLaunchPermissionMode,
+  resolveSessionPlanModePermissionMode,
+  type EmbeddedRunAttemptParamsV2,
+} from "openclaw/plugin-sdk/agent-harness-runtime";
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { loadExecApprovals } from "openclaw/plugin-sdk/exec-approvals-runtime";
+import { defineCodexBuildState } from "../build-state.js";
+import type { CodexAppServerClient } from "./client.js";
+import { resolveOpenClawExecPolicyForCodexAppServer } from "./config.js";
+import { CODEX_SESSION_PERMISSION_EXEC_MODES } from "./session-permission-policy.js";
+
+export type CodexNativeCollaborationModeName = "default" | "plan";
+
+type CodexSessionPermissionMode = NonNullable<EmbeddedRunAttemptParamsV2["permissionMode"]>;
+
+export type CodexNativeCollaborationModeInput = Readonly<{
+  mode: CodexNativeCollaborationModeName;
+  settings: Readonly<{
+    model: string;
+    reasoning_effort?: string | null;
+    developer_instructions?: string | null;
+  }>;
+}>;
+
+/** The exact native settings Codex needs to preserve when only changing mode. */
+export type CodexNativeCollaborationMode = Readonly<{
+  mode: CodexNativeCollaborationModeName;
+  settings: Readonly<{
+    model: string;
+    reasoning_effort: string | null;
+    developer_instructions: string | null;
+  }>;
+}>;
+
+type CodexNativeSettingsRequestOptions = NonNullable<
+  Parameters<CodexAppServerClient["request"]>[2]
+>;
+
+const CODEX_NATIVE_THREAD_SETTINGS_MAX_ENTRIES = 64;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/** A mode toggle is safe only when the complete native settings snapshot is known. */
+function parseCodexNativeCollaborationMode(
+  value: unknown,
+): CodexNativeCollaborationMode | undefined {
+  if (!isRecord(value) || (value.mode !== "default" && value.mode !== "plan")) {
+    return undefined;
+  }
+  const settings = value.settings;
+  if (!isRecord(settings)) {
+    return undefined;
+  }
+  const model = settings.model;
+  const reasoningEffort = settings.reasoning_effort;
+  const developerInstructions = settings.developer_instructions;
+  if (
+    typeof model !== "string" ||
+    !("reasoning_effort" in settings) ||
+    !isStringOrNull(reasoningEffort) ||
+    !("developer_instructions" in settings) ||
+    !isStringOrNull(developerInstructions)
+  ) {
+    return undefined;
+  }
+  return {
+    mode: value.mode,
+    settings: {
+      model,
+      reasoning_effort: reasoningEffort,
+      developer_instructions: developerInstructions,
+    },
+  };
+}
+
+function isStringOrNull(value: unknown): value is string | null {
+  return value === null || typeof value === "string";
+}
+
+export function withCodexNativeCollaborationMode(
+  current: CodexNativeCollaborationMode,
+  mode: CodexNativeCollaborationModeName,
+): CodexNativeCollaborationMode {
+  return {
+    mode,
+    settings: {
+      ...current.settings,
+      ...(current.mode === mode ? {} : { developer_instructions: null }),
+    },
+  };
+}
+
+type FreshThreadSettingsWaiter = {
+  promise: Promise<CodexNativeCollaborationMode>;
+  dispose: () => void;
+};
+
+function hasSameNativeSettings(
+  actual: CodexNativeCollaborationMode,
+  expected: CodexNativeCollaborationMode,
+): boolean {
+  return (
+    actual.mode === expected.mode &&
+    actual.settings.model === expected.settings.model &&
+    actual.settings.reasoning_effort === expected.settings.reasoning_effort &&
+    actual.settings.developer_instructions === expected.settings.developer_instructions
+  );
+}
+
+function watchFreshThreadSettingsUpdate(params: {
+  client: CodexAppServerClient;
+  threadId: string;
+  expected: CodexNativeCollaborationMode;
+  timeoutMs: number;
+  assertCurrent?: () => void;
+}): FreshThreadSettingsWaiter {
+  openCodexNativeThreadSettings(params.client);
+  let settled = false;
+  let removeNotificationHandler: () => void = () => {};
+  let removeCloseHandler: () => void = () => {};
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  let resolvePromise!: (value: CodexNativeCollaborationMode) => void;
+  let rejectPromise!: (error: Error) => void;
+  const promise = new Promise<CodexNativeCollaborationMode>((resolve, reject) => {
+    resolvePromise = resolve;
+    rejectPromise = reject;
+  });
+  const dispose = () => {
+    if (timeout) {
+      clearTimeout(timeout);
+      timeout = undefined;
+    }
+    removeNotificationHandler();
+    removeCloseHandler();
+  };
+  const resolve = (value: CodexNativeCollaborationMode) => {
+    if (settled) {
+      return;
+    }
+    settled = true;
+    dispose();
+    resolvePromise(value);
+  };
+  const reject = (error: Error) => {
+    if (settled) {
+      return;
+    }
+    settled = true;
+    dispose();
+    rejectPromise(error);
+  };
+  removeNotificationHandler = params.client.addNotificationHandler((notification) => {
+    if (notification.method !== "thread/settings/updated" || !isRecord(notification.params)) {
+      return;
+    }
+    if (notification.params.threadId !== params.threadId) {
+      return;
+    }
+    try {
+      params.assertCurrent?.();
+      const threadSettings = notification.params.threadSettings;
+      const received = parseCodexNativeCollaborationMode(
+        isRecord(threadSettings) ? threadSettings.collaborationMode : undefined,
+      );
+      if (!received) {
+        throw new Error("Codex returned incomplete native settings for a new thread.");
+      }
+      if (!hasSameNativeSettings(received, params.expected)) {
+        throw new Error("Codex native settings changed while initializing a new thread.");
+      }
+      const cached = readCodexNativeThreadSettings(params.client, params.threadId);
+      if (!cached || !hasSameNativeSettings(cached, params.expected)) {
+        throw new Error("Codex native settings notification was not retained by the client.");
+      }
+      resolve(cached);
+    } catch (error) {
+      reject(error instanceof Error ? error : new Error(String(error)));
+    }
+  });
+  removeCloseHandler = params.client.addCloseHandler(() => {
+    reject(new Error("Codex app-server client closed before native settings were read back."));
+  });
+  timeout = setTimeout(
+    () => {
+      reject(
+        new Error("Timed out waiting for authoritative native settings for a new Codex thread."),
+      );
+    },
+    Math.max(1, params.timeoutMs),
+  );
+  return { promise, dispose };
+}
+
+/** Applies an explicit mode to a just-started thread and waits for native readback. */
+export async function updateCodexFreshThreadSettings(params: {
+  client: CodexAppServerClient;
+  threadId: string;
+  mode: CodexNativeCollaborationModeName;
+  model: string;
+  reasoningEffort: string | null | undefined;
+  requestOptions: CodexNativeSettingsRequestOptions;
+}): Promise<CodexNativeCollaborationMode> {
+  if (typeof params.model !== "string" || !isStringOrNull(params.reasoningEffort)) {
+    throw new Error("Cannot initialize native Codex mode without actual thread model and effort.");
+  }
+  const expected: CodexNativeCollaborationMode = {
+    mode: params.mode,
+    settings: {
+      model: params.model,
+      reasoning_effort: params.reasoningEffort,
+      developer_instructions: null,
+    },
+  };
+  const waiter = watchFreshThreadSettingsUpdate({
+    client: params.client,
+    threadId: params.threadId,
+    expected,
+    timeoutMs: params.requestOptions.timeoutMs ?? 30_000,
+    assertCurrent: params.requestOptions.assertCurrent,
+  });
+  try {
+    const [, actual] = await Promise.all([
+      params.client.request(
+        "thread/settings/update",
+        { threadId: params.threadId, collaborationMode: expected },
+        params.requestOptions,
+      ),
+      waiter.promise,
+    ]);
+    params.requestOptions.assertCurrent?.();
+    return actual;
+  } finally {
+    waiter.dispose();
+  }
+}
+
+/** Resolve native and process policy from one captured session row. */
+export function resolveCodexSessionModePolicy(
+  sessionEntry:
+    | Readonly<{
+        planMode?: boolean;
+        permissionMode?: CodexSessionPermissionMode | null;
+      }>
+    | undefined,
+  params: { config?: OpenClawConfig; agentId?: string },
+) {
+  const planMode = sessionEntry?.planMode;
+  const storedPermissionMode = sessionEntry ? (sessionEntry.permissionMode ?? null) : undefined;
+  const permissionMode = resolveSessionPlanModePermissionMode({
+    planMode,
+    permissionMode: storedPermissionMode,
+  });
+  const launchPermissionMode = resolveSessionPlanModeLaunchPermissionMode({
+    planMode,
+    storedPermissionMode,
+    effectivePermissionMode: permissionMode,
+  });
+  const execPolicy = resolveOpenClawExecPolicyForCodexAppServer({
+    permissionMode: launchPermissionMode,
+    execOverrides: launchPermissionMode
+      ? { mode: CODEX_SESSION_PERMISSION_EXEC_MODES[launchPermissionMode] }
+      : undefined,
+    approvals: launchPermissionMode === "full" ? undefined : loadExecApprovals(),
+    config: params.config,
+    agentId: params.agentId,
+  });
+  return { permissionMode, launchPermissionMode, execPolicy };
+}
+
+/** A mode toggle is safe only when the complete native settings snapshot is known. */
+export function resolveCodexNativeCollaborationMode(params: {
+  planMode: boolean | undefined;
+  nativeSettings: CodexNativeCollaborationMode | undefined;
+  selectedModel?: string;
+}): CodexNativeCollaborationMode | undefined {
+  if (params.planMode === undefined) {
+    return undefined;
+  }
+  if (!params.nativeSettings) {
+    throw new Error(
+      "Cannot change native Codex Plan mode without a complete thread settings snapshot.",
+    );
+  }
+  if (params.selectedModel && params.nativeSettings.settings.model !== params.selectedModel) {
+    throw new Error(
+      "Cannot change native Codex Plan mode while the selected model differs from the native thread model.",
+    );
+  }
+  return withCodexNativeCollaborationMode(
+    params.nativeSettings,
+    params.planMode ? "plan" : "default",
+  );
+}
+
+/** Preserve supervision's native turn settings and the existing default path. */
+export function buildCodexNativeTurnStartModeParams(params: {
+  planCollaborationMode: CodexNativeCollaborationMode | undefined;
+  usesSupervisionConnection: boolean;
+  model: string;
+  effort: string | undefined;
+}) {
+  if (params.planCollaborationMode) {
+    return { collaborationMode: params.planCollaborationMode };
+  }
+  if (params.usesSupervisionConnection) {
+    return {};
+  }
+  return {
+    effort: params.effort,
+    collaborationMode: {
+      mode: "default" as const,
+      settings: {
+        model: params.model,
+        reasoning_effort: params.effort,
+        developer_instructions: null,
+      },
+    },
+  };
+}
+
+/** A per-physical-client LRU; it is a readback cache, never persisted authority. */
+class CodexNativeThreadSettingsCache {
+  readonly #entries = new Map<string, CodexNativeCollaborationMode>();
+  readonly #maxEntries: number;
+
+  constructor(maxEntries = CODEX_NATIVE_THREAD_SETTINGS_MAX_ENTRIES) {
+    if (!Number.isSafeInteger(maxEntries) || maxEntries < 1) {
+      throw new RangeError("Codex native thread settings cache limit must be positive");
+    }
+    this.#maxEntries = maxEntries;
+  }
+
+  get(threadId: string): CodexNativeCollaborationMode | undefined {
+    const value = this.#entries.get(threadId);
+    if (!value) {
+      return undefined;
+    }
+    this.#entries.delete(threadId);
+    this.#entries.set(threadId, value);
+    return withCodexNativeCollaborationMode(value, value.mode);
+  }
+
+  set(threadId: string, value: unknown): boolean {
+    const settings = parseCodexNativeCollaborationMode(value);
+    if (!settings) {
+      this.#entries.delete(threadId);
+      return false;
+    }
+    this.#entries.delete(threadId);
+    while (this.#entries.size >= this.#maxEntries) {
+      const oldest = this.#entries.keys().next().value;
+      if (oldest === undefined) {
+        break;
+      }
+      this.#entries.delete(oldest);
+    }
+    this.#entries.set(threadId, settings);
+    return true;
+  }
+
+  delete(threadId: string): void {
+    this.#entries.delete(threadId);
+  }
+
+  clear(): void {
+    this.#entries.clear();
+  }
+
+  get size(): number {
+    return this.#entries.size;
+  }
+}
+
+const getNativeSettingsState = defineCodexBuildState(
+  "openclaw.codexAppServerNativeThreadSettings",
+  () => ({ caches: new WeakMap<object, CodexNativeThreadSettingsCache>() }),
+);
+
+export function openCodexNativeThreadSettings(client: CodexAppServerClient): void {
+  const state = getNativeSettingsState();
+  if (state.caches.has(client)) {
+    return;
+  }
+  const cache = new CodexNativeThreadSettingsCache();
+  state.caches.set(client, cache);
+  const removeNotificationHandler = client.addNotificationHandler((notification) => {
+    if (notification.method === "thread/settings/updated") {
+      const params = notification.params;
+      if (isRecord(params) && typeof params.threadId === "string") {
+        const threadSettings = params.threadSettings;
+        cache.set(
+          params.threadId,
+          isRecord(threadSettings) ? threadSettings.collaborationMode : undefined,
+        );
+      }
+    } else if (
+      notification.method === "thread/archived" ||
+      notification.method === "thread/deleted" ||
+      notification.method === "thread/closed"
+    ) {
+      const params = notification.params;
+      if (isRecord(params) && typeof params.threadId === "string") {
+        cache.delete(params.threadId);
+      }
+    }
+  });
+  client.addCloseHandler(() => {
+    removeNotificationHandler();
+    cache.clear();
+    state.caches.delete(client);
+  });
+}
+
+export function readCodexNativeThreadSettings(
+  client: object,
+  threadId: string,
+): CodexNativeCollaborationMode | undefined {
+  return getNativeSettingsState().caches.get(client)?.get(threadId);
+}
+
+export function recordCodexNativeThreadSettings(
+  client: object,
+  threadId: string,
+  value: unknown,
+): boolean {
+  return getNativeSettingsState().caches.get(client)?.set(threadId, value) ?? false;
+}
